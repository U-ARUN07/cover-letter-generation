# Backend Configuration
PROJECT_NAME="AI-Powered Cover Letter Generation"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL supported, default fallback to SQLite for local development)
DATABASE_URL="sqlite:///./cover_letter_app.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cover_letter_db"

# LLM Provider Configuration ("gemini", "openai", or "ollama")
LLM_PROVIDER="gemini"

# Google Gemini API Key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Key (Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Ollama Configuration (Local, Free, No API Key Required)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Resume Parsing API Integration (Optional External Service)
# Repository: https://github.com/U-ARUN07/resume-parsing-api
RESUME_PARSING_API_URL="http://localhost:8001"

# CORS Origins (comma-separated or list)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
